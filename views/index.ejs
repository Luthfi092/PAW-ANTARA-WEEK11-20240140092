<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= storeName %> — UrbanCart</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = { darkMode: 'class' };
  </script>
  <!--
    Cegah "flash" putih sebelum JS lain jalan: baca preferensi dark mode
    dari localStorage SEBELUM body di-render.
  -->
  <script>
    if (
      localStorage.getItem('theme') === 'dark' ||
      (!localStorage.getItem('theme') && window.matchMedia('(prefers-color-scheme: dark)').matches)
    ) {
      document.documentElement.classList.add('dark');
    }
  </script>
</head>
<body class="bg-slate-950 text-slate-100 min-h-screen transition-colors selection:bg-fuchsia-500/30">

  <div class="min-h-screen bg-[radial-gradient(circle_at_top_right,_rgba(217,70,239,0.16),_transparent_28%),radial-gradient(circle_at_bottom_left,_rgba(59,130,246,0.12),_transparent_25%)]">
    <!-- NAVBAR -->
    <header class="sticky top-0 z-10 border-b border-white/10 bg-slate-950/85 backdrop-blur-xl">
      <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-fuchsia-500 to-indigo-600 flex items-center justify-center shadow-lg shadow-fuchsia-500/20">
            <span class="font-black text-lg">U</span>
          </div>
          <div>
            <h1 class="text-xl font-black tracking-tight"><%= storeName %></h1>
            <p class="text-xs text-slate-400">Modern catalog · dynamic shopping</p>
          </div>
        </div>

        <div class="flex items-center gap-2">
          <button id="theme-toggle" class="w-10 h-10 rounded-xl border border-white/10 bg-white/5 hover:bg-white/10 transition" title="Ganti tema">
            <span id="theme-icon">☀</span>
          </button>
          <button id="cart-toggle" class="relative w-10 h-10 rounded-xl bg-fuchsia-500 hover:bg-fuchsia-400 transition shadow-lg shadow-fuchsia-500/20" title="Buka keranjang">
            <span class="text-lg">Bag</span>
            <span id="cart-badge" class="hidden absolute -top-2 -right-2 bg-white text-slate-950 border-2 border-fuchsia-500 text-[10px] font-black rounded-full min-w-6 h-6 px-1 items-center justify-center">0</span>
          </button>
        </div>
      </div>
    </header>

    <main class="max-w-6xl mx-auto px-4 py-8">
      <section class="mb-8 rounded-3xl border border-white/10 bg-white/[0.04] p-6 sm:p-8 overflow-hidden relative">
        <div class="absolute -right-16 -top-16 w-48 h-48 rounded-full bg-fuchsia-500/10 blur-3xl"></div>
        <p class="text-fuchsia-300 text-xs font-bold uppercase tracking-[0.25em] mb-3">Fresh collection</p>
        <h2 class="text-3xl sm:text-4xl font-black tracking-tight max-w-2xl">Temukan produk favoritmu.</h2>
        <p class="text-slate-400 mt-2 max-w-xl">Cari, filter, dan masukkan produk ke keranjang. Semua tampilan mengikuti state secara real-time.</p>
      </section>

      <section class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-6">
        <div>
          <h2 class="font-bold text-lg">Katalog Produk</h2>
          <p id="result-info" class="text-xs text-slate-500 mt-1">Menampilkan semua produk</p>
        </div>

        <div class="flex flex-col sm:flex-row gap-3">
          <label class="relative block">
            <input id="product-search" type="search" placeholder="Cari produk..." class="w-full sm:w-72 rounded-xl border border-white/10 bg-white/5 px-4 py-2.5 pl-10 text-sm text-white placeholder:text-slate-500 outline-none focus:border-fuchsia-400 focus:ring-2 focus:ring-fuchsia-400/20 transition" />
            <span class="absolute left-3 top-2.5 text-slate-500">⌕</span>
          </label>
          <div id="filter-buttons" class="flex gap-2 p-1 rounded-xl bg-white/5 border border-white/10">
            <button data-filter="all" class="filter-btn px-3 py-1.5 text-xs rounded-lg bg-fuchsia-500 text-white font-semibold">Semua</button>
            <button data-filter="available" class="filter-btn px-3 py-1.5 text-xs rounded-lg text-slate-400 hover:text-white">Tersedia</button>
            <button data-filter="out" class="filter-btn px-3 py-1.5 text-xs rounded-lg text-slate-400 hover:text-white">Habis</button>
          </div>
        </div>
      </section>

      <div id="product-list" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        <% products.forEach(function(product) { %>
          <%- include('partials/product-card', { product }) %>
        <% }) %>
      </div>

      <p id="empty-state" class="hidden text-center text-slate-500 py-16 rounded-2xl border border-dashed border-white/10">Produk tidak ditemukan. Coba kata kunci atau filter lain.</p>
    </main>

    <!-- OVERLAY + DRAWER KERANJANG (murni client-rendered, isinya dari cartStore) -->
    <div id="cart-overlay" class="hidden fixed inset-0 bg-black/70 backdrop-blur-sm z-20"></div>

    <aside
      id="cart-drawer"
      class="fixed top-0 right-0 h-full w-full sm:w-96 bg-slate-900 border-l border-white/10 shadow-2xl z-30 translate-x-full transition-transform duration-300 flex flex-col"
    >
      <div class="flex items-center justify-between px-5 py-5 border-b border-white/10">
        <h2 class="font-bold text-white">Keranjang Belanja</h2>
        <button id="cart-close" class="text-slate-400 hover:text-white text-xl">✕</button>
      </div>

      <div id="cart-items" class="flex-1 overflow-y-auto px-5 py-4 space-y-3">
        <!-- item keranjang di-render di sini lewat JS -->
      </div>

      <div class="border-t border-white/10 px-5 py-5">
        <div class="flex items-center justify-between mb-3">
          <span class="text-sm text-slate-400">Total</span>
          <span id="cart-total" class="font-black text-lg text-white">Rp0</span>
        </div>
        <button class="w-full bg-fuchsia-500 hover:bg-fuchsia-400 text-white font-bold py-3 rounded-xl text-sm transition">
          Checkout
        </button>
      </div>
    </aside>

    <footer class="max-w-6xl mx-auto px-4 pb-8 text-center text-xs text-slate-600">UrbanCart · State-driven catalog</footer>
  </div>

  <!-- Simpan data JSON di tag script terpisah (bebas error Linter VS Code & aman dari petik) -->
  <script id="initial-products-data" type="application/json">
    <%- JSON.stringify(products) %>
  </script>

  <script>
    try {
      const rawData = document.getElementById('initial-products-data').textContent;
      window.__INITIAL_PRODUCTS__ = JSON.parse(rawData);
    } catch (err) {
      console.error('Gagal parsing data produk:', err);
      window.__INITIAL_PRODUCTS__ = [];
    }
  </script>

  <script src="/js/store.js"></script>
  <script src="/js/theme.js"></script>
  <script src="/js/cart.js"></script>
  <script src="/js/products.js"></script>
</body>
</html>